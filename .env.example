# Configuration privée sur AWS : /etc/glorieux/glorieux.env ; ne pas committer la vraie configuration.
SECRET_KEY=generate-a-long-random-secret
TICKET_SECRET=generate-another-long-random-secret
DEBUG=0
ALLOWED_HOSTS=glorieux.snoopup.io,localhost,127.0.0.1
SITE_URL=https://glorieux.snoopup.io
DATABASE_PATH=/var/lib/glorieux/db.sqlite3
AWS_REGION=eu-north-1
FROM_EMAIL=Glorieux <billetterie@snoopup.io>
EMAIL_PROVIDER=ses
# AWS : rôle IAM d’instance limité à SES recommandé, sinon clés d’un utilisateur SES dédié.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Aucun paiement ni SMS factice : renseigner avant ouverture.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SMS_PROVIDER=
# Adaptateur Twilio fourni, autre prestataire à ajouter si retenu.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Exceptions exactes autorisées pour les tests ; ne dispense pas des vérifications.
TEST_ALLOWED_EMAILS=alban.debeaupuis@gmail.com,alban@audiopro.fr

# OVH HTTP2SMS : utilisateur SMS dédié, jamais les clés OVH globales.
OVH_SMS_ACCOUNT=
OVH_SMS_LOGIN=
OVH_SMS_PASSWORD=
OVH_SMS_SENDER=DIGITALEVEN
# SumUp en pause : mettre à 1 uniquement pour une ouverture explicite.
PAYMENTS_ENABLED=0

# Numéro court pour les OTP en France ; pas de liens de billets dans ce mode.
OVH_SMS_USE_SHORT_NUMBER=0
