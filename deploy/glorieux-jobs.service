[Unit]
Description=Glorieux email SMS et reconciliation paiements
After=network.target
[Service]
Type=oneshot
User=glorieux
Group=glorieux
WorkingDirectory=/opt/snoopup-glorieux
EnvironmentFile=/etc/glorieux/glorieux.env
ExecStart=/opt/snoopup-glorieux/.venv/bin/python manage.py process_jobs
MemoryMax=128M
CPUQuota=30%
TasksMax=16
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/glorieux
UMask=0077
